# RevokeAI backend — environment template
#
# THIS FILE IS TRACKED BY GIT. Never put real keys here — only in `.env`.
#
# Local setup:
#   1. Copy this file to `.env` in this same folder (backend/.env):
#        cp .env.example .env          (bash)
#        Copy-Item .env.example .env   (PowerShell)
#   2. Fill in the values in `.env` (git-ignored).

GEMINI_API_KEY=""                  # https://aistudio.google.com/apikey

# Optional overrides
GEMINI_MODEL="gemini-3.8-flash"
# Comma-separated origins allowed to call the API from a browser (no trailing slash).
# Local: http://localhost:5173   Production: https://<your-app>.vercel.app
ALLOWED_ORIGINS="http://localhost:5173"
# Optional regex for extra origins, e.g. Vercel preview deploys:
# ALLOWED_ORIGIN_REGEX="https://revoke-ai-[a-z0-9-]+\.vercel\.app"

# --- RevokeAI extension ------------------------------------------------------
REVOKEAI_ENABLED="true"
# Public RPC. It is shared with browsers via /api/health for receipt verification,
# so never use an RPC URL that embeds an API key.
REVOKEAI_RPC_URL="https://testnetrpc.mstblockchain.com"
REVOKEAI_REGISTRY_ADDRESS="0xAF6816DAB557a6e4258E210D202bc0974D7f9AE1"
REVOKEAI_EXPLORER_URL="https://testnet.mstscan.com"
REVOKEAI_SESSION_TTL_SECONDS="7200"
# Gemini document AI: vision OCR for images/scanned PDFs + semantic chunking.
# Costs 1 Gemini request per text/PDF/Word upload, 2 per image/scan. "false" = rule-based only.
REVOKEAI_SEMANTIC_CHUNKING="true"
# Model for document AI (defaults to GEMINI_MODEL).
# REVOKEAI_DOC_MODEL="gemini-3.8-flash"

# Relayer ("master") wallet that signs and pays gas for every consent write, so
# end users never need a wallet. TESTNET-ONLY key funded with tMSTC
# (faucet: https://faucet.mstblockchain.com). Generate a fresh one with:
#   .venv/Scripts/python -c "from eth_account import Account; a=Account.create(); print(a.address, a.key.hex())"
# Falls back to MST_USER_PRIVATE_KEY if unset. Without either, secure mode is disabled.
REVOKEAI_RELAYER_PRIVATE_KEY=""

# Key that signs revocation receipts (holds no funds, separate from the relayer).
# Generate with: .venv/Scripts/python -c "from eth_account import Account; print(Account.create().key.hex())"
# If empty, an ephemeral key is generated at startup and receipts stop verifying after restart.
REVOKEAI_SIGNER_KEY=""
