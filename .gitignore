# ============================================================
# RevokeAI — .gitignore
# SECURITY: secrets must NEVER be committed. Keep this block first.
# ============================================================

# --- Secrets & environment files ---
.env
.env.*
*.env
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json
service-account*.json
*-sa.json
.secrets*
# Wallet / chain deployer material (used in later steps)
*.keystore
keystore/
mnemonic*.txt
private-key*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml

# --- Node / frontend (later steps) ---
node_modules/
.next/
out/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Solidity / Hardhat / Foundry (later steps) ---
artifacts/
cache/
typechain-types/
broadcast/
forge-cache/

# --- Logs ---
logs/
*.log

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# --- Hardhat Ignition: local/in-process deployments (keep real network records) ---
ignition/deployments/chain-31337/
